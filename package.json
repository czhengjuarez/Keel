{
  "name": "keel-system",
  "private": true,
  "type": "module",
  "workspaces": [
    "docs",
    "packages/*"
  ],
  "scripts": {
    "tokens:build": "node ./scripts/export-tokens.mjs",
    "tokens:check": "node ./scripts/export-tokens.mjs --check",
    "registry:build": "npm run registry:build -w @ops-forward/keel",
    "registry:check": "npm run registry:check -w @ops-forward/keel",
    "keel:build": "npm run build -w @ops-forward/keel",
    "keel:typecheck": "npm run typecheck -w @ops-forward/keel",
    "keel:test": "npm run test -w @ops-forward/keel",
    "skill:sync": "node scripts/skill-sync.mjs",
    "skill:check": "node scripts/skill-sync.mjs --check"
  }
}
