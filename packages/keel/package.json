{
  "name": "@ops-forward/keel",
  "version": "0.2.0",
  "description": "Framework-agnostic class utilities for the Keel design system.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "keel": "./bin/keel.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./src/styles.css",
    "./ai/component-registry.json": "./src/ai/component-registry.json",
    "./ai/USAGE.md": "./src/ai/USAGE.md"
  },
  "files": [
    "dist",
    "bin",
    "src/styles.css",
    "src/tokens.css",
    "src/ai",
    "README.md"
  ],
  "sideEffects": [
    "./src/styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "registry:build": "node scripts/registry.mjs",
    "registry:check": "node scripts/registry.mjs --check",
    "prepack": "npm run registry:check && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsup": "^8.3.5",
    "typescript": "^5.6.0",
    "vitest": "^2.1.8"
  }
}
